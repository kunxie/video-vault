# Copy to .env for local development.
# Postgres connection (psycopg v3 driver).
DATABASE_URL=postgresql+psycopg://vaultuser:vaultpass@localhost:5432/videovault

# MinIO / S3 API.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=video-vault

# 20 GiB default; override to change the per-file upload cap.
MAX_UPLOAD_SIZE_BYTES=21474836480
